# Application Environment
NODE_ENV=development
PORT=5000

# Client Configuration (CORS)
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/real_estate_crm?schema=public"

# JWT Authentication (REQUIRED in production — change these values)
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-32chars+
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=real-estate-crm
JWT_AUDIENCE=real-estate-crm-client

# Bcrypt (cost factor: 10 for test/dev speed, 12 for production)
BCRYPT_COST=10
