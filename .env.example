# Application Environment
NODE_ENV=development
PORT=5000

# Client Configuration (CORS)
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/real_estate_crm?schema=public"

# JWT Authentication (REQUIRED in production — change these values)
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-32chars+
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=real-estate-crm
JWT_AUDIENCE=real-estate-crm-client

# Bcrypt (cost factor: 10 for test/dev speed, 12 for production)
BCRYPT_COST=10

# Payment-gateway webhook (REQUIRED in production — unsigned requests are
# rejected when set). Provider-neutral shared secret for the V1 HMAC boundary:
# hex HMAC-SHA256 over the raw request body, sent as x-webhook-signature.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=

# Cloudflare R2 object storage (document bytes; metadata stays in Postgres).
# All four are REQUIRED for uploads/downloads/access checks; when any is
# missing the storage boundary returns 503 and document flows stay
# metadata-only. Endpoint derives as https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com.
# The bucket must be PRIVATE with CORS allowing PUT/GET/HEAD from the app
# origin, otherwise browser uploads fail. Never commit real values.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
