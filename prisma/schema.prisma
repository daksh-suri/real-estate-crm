// Prisma schema for Real Estate CRM
// Primary Source of Truth: docs/CRM_Implementation_Blueprint_Phase3.md
// Checkpoint 11 — Booking (Booking; Reservation ACTIVE → CONVERTED,
// Unit RESERVED → BOOKED, one booking per reservation)
// Checkpoint 12 — Payments (PaymentPlan/Obligation/Record; deal-specific
// installment schedules, correction-only records, idempotent webhook)
//
// TENANT CLASSIFICATION
// ---------------------
// GLOBAL (no organizationId): Permission, Organization (is the tenant itself)
// TENANT-SCOPED (organizationId NOT NULL, indexed, FK to Organization):
//   Role, Team, User, RolePermission, TeamMembership, RefreshToken,
//   Contact, Requirement, PossibleDuplicate, Project, Unit,
//   LeadSource, Campaign, Enquiry, Lead, AssignmentRule, RoundRobinState,
//   IdempotencyKey, Deal, AuditLog, SiteVisit, Reservation, Booking,
//   PaymentPlan, PaymentObligation, PaymentRecord
//
// Tenant scoping is enforced centrally via server/src/lib/prisma.js and
// server/src/lib/tenant.js — see those files for the fail-closed extension.
// Do NOT rely on manual where: { organizationId } in service code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  ON_LEAVE
  DEACTIVATED
}

enum DataScope {
  OWN
  TEAM
  PROJECT
  ORGANIZATION
}

enum CommunicationConsent {
  OPTED_IN
  OPTED_OUT
}

enum PossibleDuplicateStatus {
  PENDING
  CONFIRMED_SAME
  CONFIRMED_DIFFERENT
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum UnitAvailability {
  AVAILABLE
  ON_HOLD
  RESERVED
  BOOKED
  BLOCKED
}

enum EnquiryChannel {
  PORTAL
  WALK_IN
  PHONE
  OWNED_FORM
}

enum LeadStatus {
  OPEN
  CONVERTED
  DISQUALIFIED
}

enum AssignmentSource {
  MANUAL
  AUTO
  UNASSIGNED
}

enum AssignmentRuleType {
  ROUND_ROBIN
}

// Fixed V1 Deal pipeline (Phase 3 #7). The first nine stages form the normal
// forward progression; CLOSED_LOST is a parallel terminal outcome reachable
// from any active stage. No custom/per-org/per-project stages in V1.
// V1 visit lifecycle. Terminal/historical states (COMPLETED, CANCELLED,
// NO_SHOW) never block future scheduling and have no exits.
enum SiteVisitStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DealStage {
  NEW
  QUALIFIED
  SITE_VISIT_SCHEDULED
  NEGOTIATION
  RESERVATION
  BOOKING_CONFIRMED
  AGREEMENT_SIGNED
  PAYMENT_IN_PROGRESS
  CLOSED_WON
  CLOSED_LOST
}

// V1 document lifecycle (Phase 3). Terminal states have no exits; a new
// version is a new row (RESUBMITTED draft), never an overwrite.
enum DocumentStatus {
  NOT_SUBMITTED
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  RESUBMITTED
}

// V1 reservation discriminator. HOLD reuses the Reservation row (no separate
// UnitHold table); the Unit.availabilityStatus effect differs (ON_HOLD vs
// RESERVED) but the lock-and-recheck machinery is identical.
enum ReservationType {
  RESERVATION
  HOLD
}

// V1 reservation lifecycle. CONVERTED is reserved for Checkpoint 11 Booking
// and is never produced here. EXPIRED/RELEASED are terminal in this
// checkpoint and never transition back to ACTIVE.
enum ReservationStatus {
  ACTIVE
  EXPIRED
  CONVERTED
  RELEASED
}

// ---------------------------------------------------------------------------
// GLOBAL — Organization is the tenant root (not tenant-scoped itself)
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant-owned children — onDelete Cascade is deliberate: tenant data has
  // no meaning without its organization. Operational history is preserved via
  // soft-delete (User.deletedAt) and audit logs in later checkpoints, not by
  // retaining orphaned tenant rows. Tier 1 financial/legal immutability
  // (future checkpoints) will use Restrict/SetNull, never Cascade.
  users               User[]
  teams               Team[]
  roles               Role[]
  rolePermissions     RolePermission[]
  teamMemberships     TeamMembership[]
  refreshTokens       RefreshToken[]
  contacts            Contact[]
  requirements        Requirement[]
  possibleDuplicates  PossibleDuplicate[]
  projects            Project[]
  units               Unit[]
  leadSources         LeadSource[]
  campaigns           Campaign[]
  enquiries           Enquiry[]
  leads               Lead[]
  assignmentRules     AssignmentRule[]
  roundRobinStates    RoundRobinState[]
  idempotencyKeys     IdempotencyKey[]
  deals               Deal[]
  auditLogs           AuditLog[]
  siteVisits          SiteVisit[]
  reservations        Reservation[]
  bookings            Booking[]
  paymentPlans        PaymentPlan[]
  paymentObligations PaymentObligation[]
  paymentRecords      PaymentRecord[]
  documents           Document[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// TENANT-SCOPED — RefreshToken lifecycle (JWT refresh rotation)
// ---------------------------------------------------------------------------

model RefreshToken {
  id             String    @id @default(uuid())
  userId         String
  organizationId String
  tokenHash      String    @unique
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedById   String?   @unique

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replacedBy   RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replaces     RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([organizationId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([userId, organizationId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// GLOBAL — Permission catalogue (not tenant-scoped)
// ---------------------------------------------------------------------------

model Permission {
  id       String @id @default(uuid())
  resource String
  action   String

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

// ---------------------------------------------------------------------------
// TENANT-SCOPED
// ---------------------------------------------------------------------------

model Role {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  users        User[]
  permissions  RolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model Team {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  memberships  TeamMembership[]
  roundRobinStates RoundRobinState[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([deletedAt])
  @@map("teams")
}

// ---------------------------------------------------------------------------
// TENANT-SCOPED — Contact & Requirement (Checkpoint 5)
// ---------------------------------------------------------------------------

model Contact {
  id                   String                @id @default(uuid())
  organizationId       String
  name                 String
  phone                String?
  normalizedPhone      String?
  email                String?
  normalizedEmail      String?
  communicationConsent CommunicationConsent  @default(OPTED_IN)
  consentUpdatedAt     DateTime?
  consentSource        String?
  deletedAt            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  requirements Requirement[]
  possibleDuplicatesA PossibleDuplicate[] @relation("ContactA")
  possibleDuplicatesB PossibleDuplicate[] @relation("ContactB")
  enquiries Enquiry[]
  leads     Lead[]
  deals     Deal[]
  siteVisits SiteVisit[]
  documents Document[]

  // Deterministic duplicate protection: same org + same normalized email + same normalized phone (both non-null) is considered same identity
  @@unique([organizationId, normalizedEmail, normalizedPhone])
  @@index([organizationId])
  @@index([organizationId, normalizedEmail])
  @@index([organizationId, normalizedPhone])
  @@index([deletedAt])
  @@map("contacts")
}

model Requirement {
  id                    String    @id @default(uuid())
  organizationId        String
  contactId             String
  unitTypePreference    String?
  budgetMin             Decimal?  @db.Decimal(15, 2)
  budgetMax             Decimal?  @db.Decimal(15, 2)
  // Phase 3 specifies preferredProjectIds[] (not a join table). Every ID is
  // validated at the service layer to reference an existing, non-deleted
  // Project in the same organization — cross-tenant references are rejected.
  preferredProjectIds   String[]  @default([])
  possessionPreference  String?
  notes                 String?   @db.Text
  isActive              Boolean   @default(true)
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  leads        Lead[]

  @@index([organizationId])
  @@index([contactId])
  @@index([organizationId, contactId])
  @@index([deletedAt])
  @@map("requirements")
}

model PossibleDuplicate {
  id             String                   @id @default(uuid())
  organizationId String
  contactAId     String
  contactBId     String
  matchSignal    String
  status         PossibleDuplicateStatus  @default(PENDING)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contactA     Contact      @relation("ContactA", fields: [contactAId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contactB     Contact      @relation("ContactB", fields: [contactBId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([organizationId, contactAId, contactBId])
  @@index([organizationId])
  @@index([contactAId])
  @@index([contactBId])
  @@index([status])
  @@map("possible_duplicates")
}

// ---------------------------------------------------------------------------
// TENANT-SCOPED — Intake & Lead Foundation (Checkpoint 7)
// Enquiry = raw intake event (append-only, never physically deleted).
// Lead = working sales record. One active OPEN Lead per
// Organization + Contact + Project (partial unique index in migration;
// project-less Leads intentionally allow multiples per Contact).
// Requirement belongs to Contact; Lead.requirementId is a reference only.
// ---------------------------------------------------------------------------

model LeadSource {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  type           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  campaigns    Campaign[]
  enquiries    Enquiry[]
  leads        Lead[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("lead_sources")
}

model Campaign {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  leadSourceId   String?
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  leadSource   LeadSource?  @relation(fields: [leadSourceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  enquiries    Enquiry[]
  leads        Lead[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([leadSourceId])
  @@map("campaigns")
}

model Enquiry {
  id             String         @id @default(uuid())
  organizationId String
  channel        EnquiryChannel
  leadSourceId   String?
  campaignId     String?
  // Channel-specific payload preserved verbatim; downstream is channel-agnostic.
  rawPayload     Json           @default("{}")
  contactId      String?
  projectId      String?
  linkedLeadId   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  leadSource   LeadSource?  @relation(fields: [leadSourceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // The working Lead this intake event is attached to (repeat enquiries
  // attach to the existing OPEN Lead; origin is tracked on Lead).
  linkedLead   Lead?        @relation("EnquiryLinkedLead", fields: [linkedLeadId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // The Lead (if any) that this Enquiry originated (1:1, enforced via
  // Lead.originEnquiryId @unique). A repeat Enquiry attached to an existing
  // Lead is NOT its origin.
  originLead   Lead?        @relation("LeadOrigin")

  @@index([organizationId])
  @@index([organizationId, contactId])
  @@index([organizationId, projectId])
  @@index([organizationId, channel])
  @@index([linkedLeadId])
  @@index([contactId])
  @@map("enquiries")
}

model Lead {
  id               String           @id @default(uuid())
  organizationId   String
  contactId        String
  projectId        String?
  requirementId    String?
  leadSourceId     String?
  campaignId       String?
  originEnquiryId  String           @unique
  assignedAgentId  String?
  assignmentSource AssignmentSource @default(UNASSIGNED)
  assignedAt       DateTime?
  status           LeadStatus       @default(OPEN)
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requirement  Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  leadSource   LeadSource?  @relation(fields: [leadSourceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // Restrict: origin Enquiry is append-only history; it must never disappear
  // under the Lead it created. Enquiries themselves have no delete endpoint.
  originEnquiry  Enquiry        @relation("LeadOrigin", fields: [originEnquiryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  linkedEnquiries Enquiry[]     @relation("EnquiryLinkedLead")
  assignedAgent  User?          @relation("LeadAssignee", fields: [assignedAgentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deals          Deal[]

  // NOTE: the "one OPEN Lead per Org+Contact+Project" invariant is enforced
  // by a partial unique index in the migration (not expressible in Prisma):
  //   WHERE status='OPEN' AND deletedAt IS NULL AND projectId IS NOT NULL.
  // Project-less Leads (projectId NULL) intentionally allow multiples.
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, contactId])
  @@index([organizationId, projectId])
  @@index([organizationId, assignedAgentId])
  @@index([contactId])
  @@index([deletedAt])
  @@map("leads")
}

model AssignmentRule {
  id             String             @id @default(uuid())
  organizationId String
  type           AssignmentRuleType
  // Evaluation order, lowest first. Field name matches Phase 3 ("order").
  order          Int                @default(0)
  // Type-specific params only (e.g. { teamId }), never logic. ROUND_ROBIN
  // requires { teamId }. PROJECT_AFFINITY/TERRITORY arrive in later passes.
  config         Json               @default("{}")
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
  @@index([organizationId, active])
  @@map("assignment_rules")
}

model RoundRobinState {
  id                 String   @id @default(uuid())
  organizationId     String
  teamId             String   @unique
  // Last agent assigned via this counter (plain id, no FK: the agent row may
  // later be deactivated/deleted and must never block the counter row).
  lastAssignedUserId String?
  // Position in the ordered eligible-agent list at assignment time.
  lastIndex          Int      @default(-1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([organizationId, teamId])
  @@index([organizationId])
  @@map("round_robin_states")
}

model IdempotencyKey {
  id               String   @id @default(uuid())
  organizationId   String
  key              String
  operationType    String   @default("ENQUIRY_INTAKE")
  requestHash      String
  responseSnapshot Json?
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([organizationId, key, operationType])
  @@index([organizationId])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// TENANT-SCOPED — Property Hierarchy (Checkpoint 6)
// Organization → Project → Unit. Phase 3: Project (name, location, status),
// Unit (projectId, identifier, totalCost, availabilityStatus).
// Requirement.preferredProjectIds stays a String[] per Phase 3 — validated
// at the service layer to reference same-org, non-deleted Projects.
// ---------------------------------------------------------------------------

model Project {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  location       String?
  status         ProjectStatus @default(ACTIVE)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  units        Unit[]
  enquiries    Enquiry[]
  leads        Lead[]
  siteVisits   SiteVisit[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([deletedAt])
  @@map("projects")
}

model Unit {
  id                 String           @id @default(uuid())
  organizationId     String
  projectId          String
  identifier         String
  totalCost          Decimal?         @db.Decimal(15, 2)
  availabilityStatus UnitAvailability @default(AVAILABLE)
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Restrict (not Cascade): a Project with Units must never be physically
  // destroyed — Units are future booking history. Lifecycle is soft-delete.
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deals        Deal[]
  reservations Reservation[]
  bookings     Booking[]

  @@unique([projectId, identifier])
  @@index([organizationId])
  @@index([projectId])
  @@index([organizationId, projectId])
  @@index([organizationId, availabilityStatus])
  @@index([deletedAt])
  @@map("units")
}

model User {
  id                         String     @id @default(uuid())
  organizationId             String
  name                       String
  email                      String
  passwordHash               String?
  roleId                     String?
  status                     UserStatus @default(ACTIVE)
  deactivatedAt              DateTime?
  reassignmentCompletedAt    DateTime?
  deletedAt                  DateTime?
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role         Role?            @relation(fields: [roleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  memberships  TeamMembership[]
  refreshTokens RefreshToken[]
  assignedLeads Lead[]          @relation("LeadAssignee")
  siteVisits    SiteVisit[]     @relation("SiteVisitAgent")

  // Tenant-scoped unique: same email can exist in different organizations,
  // but not twice within one organization.
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([roleId])
  @@map("users")
}

// Join table — tenant-scoped via organizationId. The organizationId column
// is required so the tenant extension can filter it, and so we can enforce
// cross-tenant membership invariants (user.organizationId == team.organizationId == membership.organizationId)
// at the service layer inside a transaction. The PK is a surrogate id plus a
// unique(userId, teamId) to prevent duplicate memberships; the surrogate id
// keeps the model consistent with other tenant entities for extension handling
// (all tenant models have a single uuid PK).
model TeamMembership {
  id             String   @id @default(uuid())
  userId         String
  teamId         String
  organizationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, teamId])
  @@index([organizationId])
  @@index([userId])
  @@index([teamId])
  @@map("team_memberships")
}

model RolePermission {
  id             String    @id @default(uuid())
  organizationId String
  roleId         String
  permissionId   String
  scope          DataScope

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([roleId, permissionId, scope])
  @@index([organizationId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// TENANT-SCOPED — Deal & Pipeline (Checkpoint 8)
// Deal is the working sales record created by converting an OPEN Lead.
// The pipeline is FIXED for V1 (DealStage enum): nine forward stages plus
// CLOSED_LOST as a parallel terminal outcome. No custom/per-org/per-project
// stages, no dealType/RERA fields (DEFERRED — see DEC-021).
// Deal.stageHistory is derived from audit_logs, not a separate table.
// ---------------------------------------------------------------------------

model Deal {
  id             String    @id @default(uuid())
  organizationId String
  contactId      String
  leadId         String
  // Nullable until reservation (Checkpoint 9+). Never edited by reservation
  // logic in this checkpoint; availabilityStatus is untouched by Deal flows.
  unitId         String?
  stage          DealStage @default(NEW)
  // Required when (and only when) stage is CLOSED_LOST.
  lostReason     String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Restrict (not Cascade/SetNull): a Unit referenced by a Deal is future
  // booking history and must never disappear or detach silently.
  unit         Unit?        @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  siteVisits   SiteVisit[]
  reservations Reservation[]
  bookings     Booking[]
  paymentPlans PaymentPlan[]
  documents    Document[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, leadId])
  @@index([contactId])
  @@index([deletedAt])
  @@map("deals")
}

// ---------------------------------------------------------------------------
// TENANT-SCOPED — Shared audit trail (first writer: Checkpoint 8 Deal)
// Append-only. actorId is a plain String (no FK) so history survives actor
// deactivation/deletion. Future modules reuse this table; never create
// per-entity history tables (Deal.stageHistory derives from these rows).
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  actorId        String
  entityType     String
  entityId       String
  action         String
  beforeState    Json?
  afterState     Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// TENANT-SCOPED — Site Visit scheduling (Checkpoint 9)
// A visit occupies two V1 resources: Agent (User) + Property (Project).
// Per-Unit scheduling does not exist; Unit rows are never read or written by
// this module. No deletedAt: cancellation (CANCELLED) is the removal path and
// history must remain queryable; only SCHEDULED/CONFIRMED rows participate in
// conflict checks. dealId is optional context — scheduling never mutates Deal.
// ---------------------------------------------------------------------------

model SiteVisit {
  id                 String          @id @default(uuid())
  organizationId     String
  agentId            String
  projectId          String
  contactId          String
  dealId             String?
  scheduledAt        DateTime
  durationMinutes    Int             @default(60)
  status             SiteVisitStatus @default(SCHEDULED)
  cancelledBy        String?
  cancellationReason String?
  cancelledAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Restrict: a scheduled visit is history-in-progress; the agent row must
  // never disappear under it (users are soft-deleted in practice anyway).
  agent        User         @relation("SiteVisitAgent", fields: [agentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // SetNull: the visit survives deal deletion; the deal never owns the visit.
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([organizationId])
  @@index([organizationId, agentId, scheduledAt])
  @@index([organizationId, projectId, scheduledAt])
  @@index([organizationId, status])
  @@index([contactId])
  @@index([dealId])
  @@map("site_visits")
}

// ---------------------------------------------------------------------------
// TENANT-SCOPED — Reservation & Unit Hold (Checkpoint 10)
// HOLD reuses this row with type=HOLD (no separate UnitHold table).
// Unit.availabilityStatus is the authoritative inventory state; this row's
// status is the record lifecycle. Both mutate in the same transaction while
// the Unit row is locked FOR UPDATE. No deletedAt: EXPIRED/RELEASED preserve
// history. dealId is required per Phase 3 (V1 rule — management holds without
// a Deal are deferred, see DEC-026). CONVERTED is reserved for Checkpoint 11.
// ---------------------------------------------------------------------------

model Reservation {
  id             String            @id @default(uuid())
  organizationId String
  unitId         String
  dealId         String
  type           ReservationType
  expiresAt      DateTime?
  status         ReservationStatus @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Restrict: a reserved/held Unit is inventory history-in-progress; it must
  // never disappear under its Reservation.
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // Restrict: a Reservation is sales history; the Deal must never disappear
  // or detach silently (no SetNull — dealId is required in V1).
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // One Booking per Reservation at the schema level (backstop for the
  // ACTIVE re-check): a second conversion attempt fails instead of forking.
  booking      Booking?

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([unitId])
  @@index([dealId])
  @@map("reservations")
}

// ---------------------------------------------------------------------------
// TENANT-SCOPED — Booking (Checkpoint 11)
// Conversion of one ACTIVE type=RESERVATION row: Booking insert +
// Unit RESERVED → BOOKED + Reservation ACTIVE → CONVERTED, atomically under
// the Unit FOR UPDATE lock. Lifecycle is the shared cancel triple (no status
// enum, no deletedAt): a cancelled Booking is preserved history. reservationId
// is required + unique (explicit chain; Phase 3 omits it but conversion
// validity cannot be proven from unit+deal history rows alone).
// No Deal.stage move here — the agent uses the existing stage-transition op.
// ---------------------------------------------------------------------------

model Booking {
  id             String    @id @default(uuid())
  organizationId String
  unitId         String
  dealId         String
  reservationId  String    @unique
  bookedAt       DateTime  @default(now())
  cancelledBy    String?
  cancellationReason String?
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Restrict: a booked Unit is Tier-1 history and must never disappear or
  // detach silently under its Booking.
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // Restrict: same history argument as Reservation — no SetNull.
  deal         Deal         @relation(fields: [dealId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reservation  Reservation  @relation(fields: [reservationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId])
  @@index([unitId])
  @@index([dealId])
  @@map("bookings")
}

// ---------------------------------------------------------------------------
// TENANT-SCOPED — Payments (Checkpoint 12)
// Deal-specific installment schedules. PaymentPlan hangs off one Deal (one
// plan per deal, @unique backstop); reusable/approved plan templates are
// deferred (see DEC-029) — the per-deal obligations array IS the custom
// schedule. OVERDUE is derived at read (PENDING + past dueDate), never
// written: no scheduler exists and the webhook stays the sole PAID writer.
// PaymentRecord is correction-only: new row with correctsRecordId, never
// in-place edits. No Deal/Booking/Unit writes from this module.
// ---------------------------------------------------------------------------

enum ObligationStatus {
  PENDING
  PAID
  OVERDUE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model PaymentPlan {
  id             String   @id @default(uuid())
  organizationId String
  dealId         String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Restrict: a plan is Tier-1 financial history; the Deal must never
  // disappear under it.
  deal         Deal       @relation(fields: [dealId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  obligations  PaymentObligation[]

  @@index([organizationId])
  @@map("payment_plans")
}

model PaymentObligation {
  id             String           @id @default(uuid())
  organizationId String
  paymentPlanId  String
  dueAmount      Decimal          @db.Decimal(15, 2)
  dueDate        DateTime
  status         ObligationStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  paymentPlan PaymentPlan      @relation(fields: [paymentPlanId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  records     PaymentRecord[]

  @@index([organizationId])
  @@index([paymentPlanId])
  @@index([status])
  @@map("payment_obligations")
}

model PaymentRecord {
  id               String        @id @default(uuid())
  organizationId   String
  obligationId     String
  amount           Decimal       @db.Decimal(15, 2)
  status           PaymentStatus
  gatewayReference String?
  correctsRecordId String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Restrict throughout: payment history is never detached or removed.
  obligation   PaymentObligation @relation(fields: [obligationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  corrects     PaymentRecord?    @relation("RecordCorrection", fields: [correctsRecordId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  correctedBy  PaymentRecord?    @relation("RecordCorrection")

  @@index([organizationId])
  @@index([obligationId])
  @@index([gatewayReference])
  @@map("payment_records")
}

// ---------------------------------------------------------------------------
// TENANT-SCOPED — Documents (Checkpoint 13)
// One row per version. Versions share groupId; supersedesId chains child to
// parent (@unique: one child per parent). Tier 1: finalized rows are never
// overwritten or deleted — resubmission inserts. No deletedAt by design.
// `type` is free-form (no values specified anywhere — see DEC-030).
// storageKey is server-derived, never client-supplied.
// ---------------------------------------------------------------------------

model Document {
  id               String         @id @default(uuid())
  organizationId   String
  groupId          String
  version          Int            @default(1)
  supersedesId     String?        @unique
  contactId        String
  dealId           String?
  type             String
  status           DocumentStatus @default(NOT_SUBMITTED)
  storageKey       String
  rejectionReason  String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // SetNull: the document survives deal deletion; the deal never owns it.
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supersedes   Document?    @relation("VersionChain", fields: [supersedesId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersededBy Document?    @relation("VersionChain")

  @@index([organizationId])
  @@index([organizationId, groupId])
  @@index([contactId])
  @@index([dealId])
  @@map("documents")
}
